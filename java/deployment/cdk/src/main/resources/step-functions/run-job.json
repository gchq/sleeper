{
  "Type": "Task",
  "Resource": "arn:partition-placeholder:states:::eks:runJob.sync",
  "Parameters": {
    "ClusterName": "cluster-placeholder",
    "CertificateAuthority": "ca-placeholder",
    "Endpoint": "endpoint-placeholder",
    "Namespace": "namespace-placeholder",
    "Job": {
      "apiVersion": "batch/v1",
      "kind": "Job",
      "metadata": {
        "name.$": "$.job.id"
      },
      "spec": {
        "ttlSecondsAfterFinished": 600,
        "backoffLimit": 0,
        "template": {
          "metadata": {
            "annotations": {
              "karpenter.sh/do-not-disrupt": "true"
            }
          },
          "spec": {
            "serviceAccountName": "spark-submit",
            "containers": [
              {
                "image": "image-placeholder",
                "name": "spark-submit",
                "args.$": "$.args",
                "env": [
                  {
                    "name": "EXECUTOR_POD_TEMPLATE",
                    "value.$": "$.executorPodTemplate"
                  }
                ]
              }
            ],
            "restartPolicy": "Never"
          }
        }
      }
    },
    "LogOptions": {
      "RetrieveLogs": true,
      "LogParameters": {
        "tailLines": [
          "10"
        ]
      }
    }
  },
  "ResultSelector": {
    "succeeded.$": "$.status.succeeded",
    "logs.$": "$.logs..spark-submit.log"
  },
  "ResultPath": "$.jobResult",
  "Retry": [
    {
      "ErrorEquals": [
        "EKS.403"
      ],
      "IntervalSeconds": 60,
      "MaxAttempts": 720,
      "BackoffRate": 1.0,
      "JitterStrategy": "FULL"
    }
  ],
  "Catch": [
    {
      "ErrorEquals": [
        "States.ALL"
      ],
      "ResultPath": "$.error",
      "Next": "CreateErrorMessage"
    }
  ]
}
